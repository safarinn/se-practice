@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
hide methods
hide circle
title Course registration - domain model
class Student {
  studentId : String
  name : String
}
class Course {
  code : String
  title : String
}
class CourseOffering {
  offeringId : String
  semester : String
  capacity : Integer
  /availablePlaces : Integer
}
class Enrollment {
  enrollmentId : String
}
Student "1" -- "0..*" Enrollment : holds >
CourseOffering "1" -- "0..*" Enrollment : receives >
Course "1" -- "0..*" CourseOffering : is offered as >
note "Capacity (R2): capacity > 0;\ncount(enrollments for offering) <= capacity.\n/availablePlaces = capacity - count(enrollments)." as N1
N1 .. CourseOffering
note "Uniqueness (R3): at most one Enrollment\nfor each (studentId, offeringId) pair." as N2
N2 .. Enrollment
@enduml
